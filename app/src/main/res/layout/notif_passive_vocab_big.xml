<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/notif_big_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="14dp"
    android:paddingEnd="14dp"
    android:paddingTop="10dp"
    android:paddingBottom="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/notif_meta"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="THẺ TỪ VỰNG GHIM • 1 / 50"
            android:textSize="10.5sp"
            android:textStyle="bold"
            android:textColor="#0284C7"
            android:singleLine="true"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/notif_deck"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Giáo trình Tiếng Trung"
            android:textSize="10.5sp"
            android:textColor="#64748B"
            android:maxWidth="170dp"
            android:singleLine="true"
            android:ellipsize="end" />
    </LinearLayout>

    <TextView
        android:id="@+id/notif_foreign"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="保险  [Bǎo xiǎn]"
        android:textSize="19sp"
        android:textStyle="bold"
        android:textColor="#0F172A"
        android:maxLines="2"
        android:ellipsize="end" />

    <TextView
        android:id="@+id/notif_vi"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:text="Bảo hiểm"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="#334155"
        android:maxLines="2"
        android:ellipsize="end" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal"
        android:gravity="center">

        <TextView
            android:id="@+id/notif_btn_prev"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_weight="1"
            android:background="@drawable/bg_vocab_widget_btn"
            android:gravity="center"
            android:text="Từ trước"
            android:textColor="#F8FAFC"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/notif_btn_speak"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_vocab_widget_btn"
            android:gravity="center"
            android:text="Phát âm"
            android:textColor="#38BDF8"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/notif_btn_next"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_weight="1"
            android:background="@drawable/bg_vocab_widget_btn"
            android:gravity="center"
            android:text="Từ tiếp"
            android:textColor="#F8FAFC"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
